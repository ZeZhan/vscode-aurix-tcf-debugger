{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
        "BitSize": {
            "type": "integer",
            "minimum": 1
        },
        "BitOffs": {
            "type": "integer",
            "minimum": 0
        },
        "Address": {
            "type": "number"
        },
        "Register": {
            "type": "string"
        },
        "Size": {
            "type": "number"
        },
        "Value": {
            "type": "string"
        }
    },
    "anyOf": [
        { "required": ["Size"] },
        { "required": ["BitSize"] }
    ],
    "type": "object"
}
